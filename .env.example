# ─── MSAL + Azure Function App (most values come from .azure/provision-output.json) ───
#
# After running ./scripts/provision-azure.ps1, these values are read at
# build time from .azure/provision-output.json. Override here if you need
# to point a dev build at different infrastructure.

# MSAL_CLIENT_ID=<desktop public client appId>
# MSAL_TENANT_ID=a11e9e5c-cebe-4b1e-8dc7-20de7d5e08fd
# LLM_API_APP_ID=<LLM API app reg appId>
# FEEDBACK_API_APP_ID=<feedback API app reg appId>
# LLM_PROXY_URL=https://func-cost-estimator-llm.azurewebsites.net
# FEEDBACK_API_URL=https://func-cost-estimator-feedback.azurewebsites.net

# ─── CostEstDB (independent service) ───
# Required for pricing lookups. Include ?code= for Azure Function auth.
COSTESTDB_MCP_URL=https://func-costestdb-mcp.azurewebsites.net/runtime/webhooks/mcp/sse?code=YOUR_FUNCTION_KEY_HERE

# ─── AutoCAD (local) ───
# AutoCAD 2024 is 24.3. Override if a different version is installed.
AUTOCAD_PROGID=AutoCAD.Application.24.3

# ─── Optional ───
# UPDATE_SERVER_URL=https://abonmarche-updates.example.com/cost-estimator/
